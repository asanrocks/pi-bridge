{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": false,
    // A failed typecheck must not leave compiled files behind: `rootDir` conflicts
    // would otherwise emit next to the sources.
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "public",
    "sourceMap": false,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
